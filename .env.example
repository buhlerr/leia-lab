# Banco: casa com o docker-compose.yml deste repositorio.
DATABASE_URL=postgresql://leia:leia_lab_2026@localhost:5433/leia_lab
# Banco usado pela suite de testes (criado automaticamente pelo conftest).
TEST_DATABASE_URL=postgresql://leia:leia_lab_2026@localhost:5433/leia_lab_test

# Provedor de LLM e de embeddings. Sem a chave, o pipeline cai no modo offline.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CHAT_MODEL=deepseek/deepseek-v4.1-flash
# Limite de tokens por resposta do chat (o redator precisa de JSON completo).
CHAT_MAX_TOKENS=1500
# Teto de gasto OpenRouter por analise (chamadas do redator), em dolares.
ANALYSIS_MAX_COST_USD=0.05
# Pede aos provedores que nao retenham os dados enviados (allow liberava treino).
OPENROUTER_DATA_COLLECTION=deny
EMBEDDING_MODEL=openai/text-embedding-3-small
