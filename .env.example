# Banco: casa com o docker-compose.yml deste repositorio.
DATABASE_URL=postgresql://leia:leia_lab_2026@localhost:5433/leia_lab
# Banco usado pela suite de testes (criado automaticamente pelo conftest).
TEST_DATABASE_URL=postgresql://leia:leia_lab_2026@localhost:5433/leia_lab_test

# Provedor de LLM e de embeddings. Sem a chave, o pipeline cai no modo offline.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-flash
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
# Embeddings gratuitos nao tem endpoint sem retencao. Para minutas reais: true,
# com um modelo pago como openai/text-embedding-3-small.
EMBEDDING_ZERO_RETENTION=false

# Usados pelo docker-compose.yml (senha sem default de proposito).
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_PORT=5433
# Interface publicada; no servidor, use o IP da rede local em vez de 0.0.0.0.
POSTGRES_BIND=127.0.0.1
